---
import { Water } from '../components/water/Water';

import '../styles/global.css';

const name = 'Aliaksandr Zhukau';
const description = 'Personal website of Aliaksandr Zhukau. Coming soon.';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{name}</title>
  </head>
  <body class="grid min-h-dvh place-items-center bg-neutral-100 px-6 text-neutral-900 antialiased dark:bg-neutral-900 dark:text-neutral-100">
    <main class="flex flex-col items-center gap-4 text-center">
      <h1 class="w-min text-[min(18vw,10rem)] leading-none font-bold tracking-tight">{name}</h1>
    </main>
    <Water client:only="react" />
  </body>
</html>
